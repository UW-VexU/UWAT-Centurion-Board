	(text "J15 spare SPI (SPI3): 1 3V3, 2 GND, 3 SCK, 4 MOSI, 5 MISO, 6 CS, 7 INT.\nFor a plug-in board later, for example a MAX3421E USB host breakout.\nA USB host also needs its own switched, current limited 5 V for VBUS." (exclude_from_sim no) (at 109.22 116.84 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9a4b339d-265e-416a-b436-d190a1f3e1e2"))(symbol (lib_id "power:GND") (at 134.62 91.44 0) (unit 1) (body_style 1) (exclude_from_sim no) (in_bom no) (on_board yes) (in_pos_files yes) (dnp no) (uuid "b2caea16-e734-48cb-bde1-1202f6f9693e") (property "Reference" "#PWR301" (at 134.62 91.44 0) (hide yes) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.27)))) (property "Value" "GND" (at 134.62 95.25 0) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.27)))) (property "Footprint" "" (at 134.62 91.44 0) (hide yes) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 134.62 91.44 0) (hide yes) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.27)))) (property "Description" "Power symbol creates a global label with name \"GND\"" (at 134.62 91.44 0) (hide yes) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "aa542e3b-4131-41c3-b80c-16b23fd1a453")) (instances (project "centurion" (path "/3032cbe1-6c0a-4e14-b8a3-fd74e7e48062/380feb03-a3a1-433f-8f94-5b17d09f05ae" (reference "#PWR301") (unit 1)))))
