(version 1)

# Board Setup's hole clearance floor is 0.15 mm only so that the stock GCT USB4105
# footprint (J16) passes: its outer GND pads sit 0.19 mm from the plastic locating holes.
# Everything else is held to 0.25 mm here.
(rule "Hole clearance"
	(constraint hole_clearance (min 0.25mm))
	(condition "!A.memberOfFootprint('J16') || !B.memberOfFootprint('J16')"))
