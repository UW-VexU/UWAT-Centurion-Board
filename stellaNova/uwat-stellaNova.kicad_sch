  (label "U0TXD" (at 160.02 233.68 270) (fields_autoplaced)
    (effects
      (font (size 1.27 1.27)) (justify right bottom)) (uuid 305bace5-178d-59ef-b542-689d594c0739))
  (label "U0RXD" (at 177.8 233.68 270) (fields_autoplaced)
    (effects
      (font (size 1.27 1.27)) (justify right bottom)) (uuid c4279f34-ba85-5a6c-bbc6-ff4a2a5a9eb8))
  (text "No mounting holes: the board hangs from its smart cable.\nKeep metal at least 15 mm from the antenna end for good range." (at 106.68 243.84 0)
    (effects
      (font (size 1.27 1.27)) (justify left top)) (uuid f13671c0-3b1d-54f0-9f71-b7a9c3afee4e))
  (rectangle (start 205.74 165.1) (end 322.58 246.38)
    (stroke (width 0.254) (type dash) (color 72 72 72 1))
    (fill (type none)) (uuid 45486008-56e9-5a2a-b320-b707ff5f18e0))
  (text "Firmware pin map" (at 208.28 167.64 0)
    (effects
      (font (size 2 2)
        bold) (justify left top)) (uuid 44ccb695-7400-590e-88ff-285c2f31fbfe))
  (text "All signals 3.3 V. GPIO numbers are ESP32-S3 IO numbers." (at 208.28 171.45 0)
    (effects
      (font (size 1.27 1.27)
        italic) (justify left top)) (uuid edb4c80e-c850-54b0-afa9-395b43e6b819))
  (text "RS-485  RX IO9   DE IO10   TX IO11   (UART_MODE_RS485_HALF_DUPLEX, RTS = IO10)\nUSB     D- IO19  D+ IO20   (USB Serial/JTAG, auto-reset into bootloader)\nmicroSD CLK IO40  CMD IO41  D0 IO39  D1 IO38  D2 IO2  D3 IO42  DET IO1 (low = card in)\nLEDs    LINK IO13  ACT IO14  (high = on)\nButtons RESET = EN,  BOOT = IO0\nUART0   TX IO43 (TP4), RX IO44 (TP5): ROM boot log\n\nBrain side: vexGenericSerialEnable(port, 0) then\nvexGenericSerialBaudrate(port, 230400). PROS: pros::Serial.\n\nModule N16R2 has quad PSRAM: set PSRAM mode to Quad, not Octal.\nStrapping pins IO3, IO45, IO46 are left floating on purpose\n(internal defaults give SPI boot and 3.3 V flash)." (at 208.28 177.8 0)
    (effects
      (font (size 1.4 1.4)) (justify left top)) (uuid d14828ee-3e52-55e1-a890-8c56e600c983))
