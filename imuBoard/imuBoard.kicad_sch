	(text "Centurion IMU board, rev 1.0. Plugs into centurion J5 with a straight JST GH 8-pin cable (pin n to pin n), 30 cm or less." (exclude_from_sim no) (at 25.4 31.75 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "3aec674c-ab05-5a1e-bd27-8c153eb45d39"))
