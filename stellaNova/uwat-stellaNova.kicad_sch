  (text "Status LEDs and test points" (at 15.24 208.28 0)
    (effects
      (font (size 2 2)
        bold) (justify left top)) (uuid 2f2f3e83-6e6e-5155-98e4-3985cbded99a))
  (text "About 1.3 mA per LED through 1 k. Blue and InGaN green need too much voltage for 3.3 V." (at 15.24 212.09 0)
    (effects
      (font (size 1.27 1.27)
        italic) (justify left top)) (uuid 9df4158c-8535-54c8-b8f7-a8cc18fd54f7))
  (label "LED_LINK" (at 50.8 223.52 90) (fields_autoplaced)
